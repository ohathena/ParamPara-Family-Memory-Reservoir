# ---------- required ----------
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parampara?retryWrites=true&w=majority
# at least 32 random characters in production. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# your frontend address(es), comma separated
CLIENT_URL=http://localhost:5173

# ---------- production ----------
# NODE_ENV=production
# TRUST_PROXY=true                 # when hosted behind a proxy (Render, Railway)
# APP_URL=https://your-app.vercel.app   # used in email links (defaults to the first CLIENT_URL)

# ---------- optional: password reset emails ----------
# Free hosts block SMTP, so email goes through an HTTPS API. Brevo is free and needs no own domain.
# EMAIL_PROVIDER=brevo             # brevo or resend
# EMAIL_API_KEY=
# MAIL_FROM=you@example.com        # must be a verified sender in Brevo/Resend
# MAIL_FROM_NAME=ParamPara
# Without this, in development the reset link is printed in the server console.

# ---------- optional: photo uploads (Cloudinary free tier) ----------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Without this, people can still paste photo links.
